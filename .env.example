# Server only. Copy to .env for local API readiness/migrations.
# Never point browser variables at a privileged key or database credential.
ILP_ENVIRONMENT=development
ILP_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# api-local supplies local settings from captured service status without a key file.
ILP_SUPABASE_URL=http://127.0.0.1:54321
ILP_SUPABASE_PUBLISHABLE_KEY=
# Hosted Preview uses its exact HTTPS URL, public key, and production environment.
# Never deploy the bounded-test admin key.

# Optional Web Push. Keep both keys in trusted server/scheduler secrets.
ILP_PUSH_PRIVATE_KEY=
ILP_PUSH_SUBJECT=
ILP_PUSH_JOB_SECRET=

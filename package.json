{
  "name": "i-love-people",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write frontend scripts/*.mjs .github package.json eslint.config.js tsconfig.json vite.config.ts playwright.config.ts vercel.json index.html README.md .prettierrc.json",
    "format:check": "prettier --check frontend scripts/*.mjs .github package.json eslint.config.js tsconfig.json vite.config.ts playwright.config.ts vercel.json index.html README.md .prettierrc.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "contracts:types": "openapi-typescript contracts/openapi.json -o frontend/src/api/schema.d.ts",
    "supabase": "supabase"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "supabase": "3.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
